.env

# Dev plans
.plan

# Claude settings
.claude

# Langgraph checkpoints and configuration
.checkpoints/
.langgraph_api

# Training environment, derived data and checkpoints
.venv-train/
training/data/
training/checkpoints/

# Interrupted evaluation runs (resumable)
evaluation/results/*.checkpoint.json

