__pycache__/
*.pyc

# Kindynos training labels: the adjudicator work file, rebuilt by `data_prep.area_trainset disagreements`
files/data/area_trainset/annotations/disputed.jsonl
evaluation/area_testset/annotator_check/annotations/disputed.jsonl

# Hugging Face cache of the Docker container (docker-compose.yml)
files/.cache/

# State of the analyses started from the web interface (api/jobs.py)
files/jobs/

# Hugging Face repositories built by `python -m publish.export_hf`
publish/build/

# Web interface (frontend/): the npm packages and the builds, made by `npm ci` and `npm run build`
frontend/node_modules/
frontend/*/dist/
