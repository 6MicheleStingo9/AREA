# Google Gemini (see docs/configuration.md)
GOOGLE_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Causal classification (see docs/configuration.md); defaults shown
# CAUSALITY_BACKEND=laya        # or llm: the LLM labels the causality (one more request per assessment)
# LAYA_MODEL=training/checkpoints/laya-causal-v4   # else MicheleStingo/laya-kindynos-causal, downloaded once
# LAYA_REVIEW_THRESHOLD=0.9

# Logging: DEBUG, INFO, WARNING, ERROR or CRITICAL; default shown
# LOG_LEVEL=INFO
