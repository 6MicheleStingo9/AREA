# Google Gemini (see README → "Required .env")
GOOGLE_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Causal classification (see README → "Causal classification (Laya)"); defaults shown
# CAUSALITY_BACKEND=laya        # or llm: the LLM labels the causality (one more request per assessment)
# LAYA_MODEL=training/checkpoints/laya-causal-v4   # else MicheleStingo/laya-kindynos-causal, downloaded once
# LAYA_REVIEW_THRESHOLD=0.9
